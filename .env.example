# 複製成 .env 後填入。金鑰只放在伺服器，不會出現在網頁原始碼
DEEPSEEK_API_KEY=
ARK_API_KEY=
# 中國區火山方舟（預設）；若用海外 BytePlus 改成 https://ark.ap-southeast.bytepluses.com/api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedream 模型 ID（依你在方舟控制台開通的版本，例如 doubao-seedream-4-0-250828 / doubao-seedream-4-5-251128）
SEEDREAM_MODEL=doubao-seedream-4-0-250828
# 部署到公開網址時務必設定，避免別人用掉你的額度
APP_PASSWORD=
PORT=8787
